---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// --- 1. CONFIGURATION & UTILS ---
const CONFIG = {
    POSTS_PER_PAGE: 6,
    LOCALE: 'fa-IR'
};

const formatDate = (date: Date) => new Intl.DateTimeFormat(CONFIG.LOCALE, { dateStyle: 'long' }).format(date);

// --- 2. DATA LAYER (Server Side) ---
const url = Astro.url;
const searchQuery = url.searchParams.get('q')?.trim() || '';
const categoryFilter = url.searchParams.get('category')?.trim() || '';
const currentPage = Math.max(1, parseInt(url.searchParams.get('page') || '1'));

const allPostsRaw = await getCollection('blog');
const allPublishedPosts = allPostsRaw
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// --- 3. FILTERING LOGIC ---
let filteredPosts = allPublishedPosts;

if (searchQuery) {
    filteredPosts = filteredPosts.filter(post => 
        post.data.title.includes(searchQuery) || 
        post.data.description.includes(searchQuery)
    );
}

if (categoryFilter && categoryFilter !== 'all') {
    filteredPosts = filteredPosts.filter(post => post.data.tags.includes(categoryFilter));
}

// --- 4. FEATURED POST LOGIC ---
const showFeatured = currentPage === 1 && !searchQuery && !categoryFilter;
let featuredPost = null;
let postsToList = filteredPosts;

if (showFeatured && filteredPosts.length > 0) {
    featuredPost = filteredPosts[0];
    postsToList = filteredPosts.slice(1);
}

// --- 5. PAGINATION CALCULATION ---
const totalPosts = postsToList.length;
const totalPages = Math.ceil(totalPosts / CONFIG.POSTS_PER_PAGE);
const startIndex = (currentPage - 1) * CONFIG.POSTS_PER_PAGE;
const endIndex = startIndex + CONFIG.POSTS_PER_PAGE;
const currentPosts = postsToList.slice(startIndex, endIndex);

// --- 6. UI HELPERS ---
const categories = [
    { name: 'همه مطالب', slug: 'all' },
    { name: 'تغذیه', slug: 'تغذیه' },
    { name: 'قلب و عروق', slug: 'قلب' },
    { name: 'تکنولوژی', slug: 'تکنولوژی' },
    { name: 'تجهیزات پزشکی', slug: 'تجهیزات پزشکی' },
    { name: 'سبک زندگی', slug: 'سبک زندگی' },
];

const title = "مجله سلامت دورامد | تکنولوژی و پزشکی";
const description = "مرجع تخصصی مقالات پزشکی هوشمند، تله‌مدیسین و سلامت دیجیتال.";

const createUrl = (pageNum: number) => {
    const newUrl = new URL(url);
    newUrl.searchParams.set('page', pageNum.toString());
    return newUrl.pathname + newUrl.search;
};
---

<Layout title={title} description={description}>
    <Navbar />
    
    <div id="toast-notification" class="fixed bottom-6 left-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-gray-900 text-white px-6 py-3 rounded-xl shadow-2xl flex items-center gap-3">
        <div class="w-6 h-6 bg-green-500 rounded-full flex items-center justify-center text-black">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
        </div>
        <span id="toast-message" class="text-sm font-bold">عملیات انجام شد</span>
    </div>

    <main class="relative pt-24 md:pt-32 pb-16 md:pb-24 min-h-screen bg-gray-50 text-gray-800 overflow-hidden">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-blue-100/50 rounded-full blur-[100px] opacity-60 pointer-events-none -z-10 translate-x-1/3 -translate-y-1/4"></div>
        <div class="fixed bottom-0 left-0 w-[400px] h-[400px] bg-cyan-100/50 rounded-full blur-[80px] pointer-events-none -z-10 -translate-x-1/3 translate-y-1/4"></div>

        <div class="container mx-auto px-4 sm:px-6 relative z-10">
            
            <div class="text-center max-w-4xl mx-auto mb-16 md:mb-20">
                <span class="inline-flex items-center gap-2 py-1.5 px-3 md:px-4 rounded-full bg-white border border-blue-100 text-doramed-primary text-[10px] md:text-xs font-bold shadow-sm mb-4 md:mb-6">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-doramed-primary opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-doramed-primary"></span>
                    </span>
                    مجله خبری و آموزشی دورامد
                </span>
                
                <h1 class="text-3xl sm:text-4xl md:text-6xl font-black text-gray-900 mb-6 tracking-tight leading-tight">
                    دنیای <span class="text-transparent bg-clip-text bg-gradient-to-r from-doramed-primary to-cyan-500">سلامت هوشمند</span>
                </h1>
                
                <p class="text-gray-500 text-sm md:text-lg mb-8 md:mb-10 max-w-2xl mx-auto">
                    {searchQuery ? `نتایج جستجو برای: "${searchQuery}"` : 'پایگاهی برای ارتقای دانش سلامت شما؛ از جدیدترین مقالات علمی تا راهکارهای عملی.'}
                </p>

                <div class="relative max-w-lg mx-auto group z-20 w-full mb-8">
                    <div class="absolute -inset-1 bg-gradient-to-r from-doramed-primary to-cyan-400 rounded-2xl blur opacity-20 group-hover:opacity-40 transition duration-500"></div>
                    <form action="/blog" method="GET" class="relative bg-white border border-gray-100 rounded-2xl p-2 flex items-center shadow-xl">
                        <input 
                            type="search" 
                            name="q"
                            value={searchQuery}
                            placeholder="جستجو در مقالات..." 
                            class="bg-transparent border-none outline-none text-gray-700 w-full placeholder-gray-400 text-sm md:text-base px-4 font-medium h-12"
                        />
                        {categoryFilter && <input type="hidden" name="category" value={categoryFilter} />}
                        <button type="submit" class="bg-doramed-primary hover:bg-doramed-dark text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all shadow-md">
                            جستجو
                        </button>
                    </form>
                </div>

                <div class="flex flex-wrap justify-center gap-2 md:gap-3">
                    {categories.map(cat => {
                        const isActive = (cat.slug === 'all' && !categoryFilter) || categoryFilter === cat.slug;
                        return (
                            <a 
                                href={cat.slug === 'all' ? '/blog' : `/blog?category=${cat.slug}`}
                                class={`px-4 py-2 rounded-full text-xs md:text-sm font-bold transition-all ${isActive 
                                    ? 'bg-gray-900 text-white shadow-lg scale-105' 
                                    : 'bg-white text-gray-600 border border-gray-200 hover:border-doramed-primary hover:text-doramed-primary'}`}
                            >
                                {cat.name}
                            </a>
                        )
                    })}
                </div>
            </div>

            {featuredPost && (
                <section class="mb-20 animate-fade-in-up">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="h-8 w-1.5 bg-doramed-primary rounded-full"></div>
                        <h3 class="text-gray-900 font-bold text-2xl">منتخب سردبیر</h3>
                    </div>

                    <article class="group relative w-full bg-white border border-gray-100 rounded-[2.5rem] overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500">
                        <div class="grid lg:grid-cols-12 gap-0 h-full">
                            <div class="lg:col-span-7 relative h-[300px] lg:h-[500px] overflow-hidden">
                                <a href={`/blog/${featuredPost.slug}`} class="block w-full h-full">
                                    <Image 
                                        src={featuredPost.data.image} 
                                        alt={featuredPost.data.title} 
                                        width={1200} height={800}
                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                    />
                                </a>
                                <div class="absolute top-6 right-6 z-20">
                                    <span class="bg-white/90 backdrop-blur text-doramed-primary text-xs font-bold px-4 py-2 rounded-full shadow-lg flex items-center gap-1">
                                        🔥 ویژه
                                    </span>
                                </div>
                            </div>

                            <div class="lg:col-span-5 p-8 lg:p-12 flex flex-col justify-center">
                                <div class="flex items-center gap-3 mb-4">
                                    <span class="text-doramed-primary text-xs font-bold bg-blue-50 px-3 py-1 rounded-lg">
                                        {featuredPost.data.tags[0]}
                                    </span>
                                    <span class="text-gray-400 text-xs">{formatDate(featuredPost.data.pubDate)}</span>
                                </div>

                                <h2 class="text-2xl lg:text-3xl font-black text-gray-900 mb-4 leading-tight group-hover:text-doramed-primary transition-colors">
                                    <a href={`/blog/${featuredPost.slug}`}>
                                        {featuredPost.data.title}
                                    </a>
                                </h2>
                                
                                <p class="text-gray-500 text-sm lg:text-base leading-relaxed mb-8 line-clamp-3">
                                    {featuredPost.data.description}
                                </p>

                                <div class="mt-auto flex items-center justify-between">
                                     <div class="flex items-center gap-2">
                                        <div class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 font-bold">
                                            {featuredPost.data.author.charAt(0)}
                                        </div>
                                        <span class="text-sm font-bold text-gray-800">{featuredPost.data.author}</span>
                                     </div>
                                     <button class="bookmark-btn w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-doramed-primary hover:text-white transition-all" data-slug={featuredPost.slug} aria-label="ذخیره">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 icon">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                                        </svg>
                                     </button>
                                </div>
                            </div>
                        </div>
                    </article>
                </section>
            )}

            <section id="posts-grid">
                <div class="flex items-center gap-3 mb-8">
                    <div class="h-2 w-2 bg-doramed-primary rounded-full animate-pulse"></div>
                    <h3 class="text-gray-900 font-bold text-xl">
                        {searchQuery ? 'نتایج یافت شده' : 'آخرین نوشته‌ها'}
                    </h3>
                </div>
                
                {currentPosts.length > 0 ? (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        {currentPosts.map(post => (
                            <article class="h-full">
                                <div class="group flex flex-col h-full bg-white border border-gray-100 rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                                    
                                    <a href={`/blog/${post.slug}`} class="block h-60 relative overflow-hidden bg-gray-100">
                                        <Image 
                                            src={post.data.image} 
                                            alt={post.data.title} 
                                            width={600} height={400}
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                                        />
                                        <div class="absolute top-4 right-4 z-10">
                                            <span class="text-[10px] font-bold text-gray-800 bg-white/95 backdrop-blur px-2.5 py-1 rounded-lg shadow-sm">
                                                {post.data.tags[0]}
                                            </span>
                                        </div>
                                    </a>

                                    <div class="p-6 flex flex-col flex-grow">
                                        <div class="flex justify-between items-center text-xs text-gray-400 mb-3">
                                            <time>{formatDate(post.data.pubDate)}</time>
                                            <span>5 دقیقه مطالعه</span>
                                        </div>
                                        
                                        <h2 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2 leading-snug group-hover:text-doramed-primary transition-colors">
                                            <a href={`/blog/${post.slug}`}>
                                                {post.data.title}
                                            </a>
                                        </h2>
                                        
                                        <p class="text-gray-500 text-sm line-clamp-2 mb-6 flex-grow leading-relaxed">
                                            {post.data.description}
                                        </p>
                                        
                                        <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between">
                                            <a href={`/blog/${post.slug}`} class="text-sm font-bold text-doramed-primary flex items-center gap-1 hover:gap-2 transition-all">
                                                ادامه مطلب
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 rtl:rotate-180">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                                </svg>
                                            </a>
                                            
                                            <button 
                                                class="bookmark-btn text-gray-300 hover:text-doramed-primary transition-colors p-2 rounded-full hover:bg-blue-50" 
                                                data-slug={post.slug}
                                                aria-label="ذخیره مقاله"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6 icon">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.593 3.322c1.1.128 1.907 1.077 1.907 2.185V21L12 17.25 4.5 21V5.507c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0z" />
                                                </svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-20 bg-white rounded-3xl border border-gray-100">
                        <p class="text-gray-500 text-lg">مقاله‌ای با این مشخصات یافت نشد.</p>
                        <a href="/blog" class="text-doramed-primary font-bold mt-4 inline-block hover:underline">مشاهده همه مقالات</a>
                    </div>
                )}

                {/* Pagination */}
                {totalPages > 1 && (
                    <div class="mt-16 flex justify-center">
                        <nav class="flex items-center gap-2 bg-white p-2 rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100">
                            {currentPage > 1 ? (
                                <a href={createUrl(currentPage - 1)} class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-600 hover:bg-doramed-primary hover:text-white transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                </a>
                            ) : (
                                <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-300 cursor-not-allowed">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
                                </span>
                            )}

                            <span class="px-4 font-bold text-gray-800">صفحه {currentPage} از {totalPages}</span>

                            {currentPage < totalPages ? (
                                <a href={createUrl(currentPage + 1)} class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-600 hover:bg-doramed-primary hover:text-white transition-colors">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                                </a>
                            ) : (
                                <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-50 text-gray-300 cursor-not-allowed">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg>
                                </span>
                            )}
                        </nav>
                    </div>
                )}
            </section>

            <section class="mt-20 relative overflow-hidden rounded-[2.5rem] bg-[#111827] p-8 md:p-12 text-center md:text-right">
                <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                    <div>
                        <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">عضویت در خبرنامه پزشکی</h3>
                        <p class="text-gray-400">دریافت هفتگی چکیده‌ای از مهم‌ترین اخبار سلامت و تکنولوژی.</p>
                    </div>
                    <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                        <input type="email" required placeholder="ایمیل شما..." class="px-5 py-3.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-gray-500 outline-none focus:border-doramed-primary w-full sm:w-80 transition-colors" />
                        <button type="submit" class="px-8 py-3.5 rounded-xl bg-doramed-primary text-white font-bold hover:bg-blue-600 transition-all shadow-lg flex items-center justify-center min-w-[120px]">
                            <span>عضویت</span>
                        </button>
                    </form>
                </div>
            </section>

        </div>
    </main>

    <Footer />
</Layout>

<script is:inline>
    // --- Toast Notification Helper ---
    function showToast(message) {
        const toast = document.getElementById('toast-notification');
        const msg = document.getElementById('toast-message');
        if (toast && msg) {
            msg.innerText = message;
            toast.classList.remove('opacity-0', 'translate-y-20');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-20');
            }, 3000);
        }
    }

    // --- 1. Newsletter Logic (Enhanced) ---
    const newsletterForm = document.getElementById('newsletter-form');
    if (newsletterForm) {
        newsletterForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const btn = newsletterForm.querySelector('button');
            const input = newsletterForm.querySelector('input');
            const originalContent = btn.innerHTML;
            
            // Loading State
            btn.disabled = true;
            btn.innerHTML = `<svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
            
            setTimeout(() => {
                showToast(`ایمیل ${input.value} با موفقیت ثبت شد!`);
                input.value = '';
                
                // Success State inside button
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>`;
                btn.classList.replace('bg-doramed-primary', 'bg-green-600');
                
                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalContent;
                    btn.classList.replace('bg-green-600', 'bg-doramed-primary');
                }, 3000);
            }, 1500);
        });
    }

    // --- 2. Bookmark Logic (Fixed & Persistent) ---
    // این بخش باعث می‌شود دکمه‌ها واقعاً کار کنند و رنگشان تغییر کند
    const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
    const STORAGE_KEY = 'doramed_bookmarks';

    // تابع برای آپدیت ظاهر دکمه بر اساس وضعیت
    const updateButtonState = (btn, isBookmarked) => {
        const icon = btn.querySelector('.icon');
        if (isBookmarked) {
            icon.setAttribute('fill', 'currentColor'); // توپر کردن آیکون
            btn.classList.add('text-doramed-primary', 'bg-blue-50');
            btn.classList.remove('text-gray-300', 'text-gray-400');
        } else {
            icon.setAttribute('fill', 'none'); // توخالی کردن
            btn.classList.remove('text-doramed-primary', 'bg-blue-50');
            btn.classList.add('text-gray-300'); // یا text-gray-400 بسته به مکان دکمه
        }
    };

    // لود اولیه: بررسی لوکال استوریج
    const savedBookmarks = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    bookmarkBtns.forEach(btn => {
        const slug = btn.getAttribute('data-slug');
        if (savedBookmarks.includes(slug)) {
            updateButtonState(btn, true);
        }

        btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation(); // جلوگیری از کلیک شدن لینک والد (اگر داخل کارت است)
            
            const currentBookmarks = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
            let newBookmarks;
            
            if (currentBookmarks.includes(slug)) {
                // حذف از لیست
                newBookmarks = currentBookmarks.filter(s => s !== slug);
                updateButtonState(btn, false);
                showToast('مقاله از لیست ذخیره‌ها حذف شد');
            } else {
                // افزودن به لیست
                newBookmarks = [...currentBookmarks, slug];
                updateButtonState(btn, true);
                showToast('مقاله ذخیره شد');
            }
            
            localStorage.setItem(STORAGE_KEY, JSON.stringify(newBookmarks));
        });
    });
</script>

<style>
    @keyframes fade-in-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in-up { animation: fade-in-up 0.8s ease-out forwards; }
</style>