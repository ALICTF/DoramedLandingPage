---
// src/pages/blog/[...slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// محاسبه زمان مطالعه
const wordCount = entry.body.split(/\s+/g).length;
const readingTime = Math.ceil(wordCount / 200);

const formattedDate = entry.data.pubDate.toLocaleDateString('fa-IR', {
    year: 'numeric', month: 'long', day: 'numeric'
});

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
    .filter(post => post.slug !== entry.slug && !post.data.draft)
    .filter(post => post.data.tags.some(tag => entry.data.tags.includes(tag)))
    .sort(() => 0.5 - Math.random())
    .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "image": entry.data.image.src,
  "author": {
    "@type": "Person",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Doramed Health",
    "logo": {
      "@type": "ImageObject",
      "url": "https://doramed.com/logo.png"
    }
  },
  "datePublished": entry.data.pubDate.toISOString(),
  "description": entry.data.description
};
---

<Layout title={entry.data.title} description={entry.data.description} image={entry.data.image.src}>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

    <Navbar />

    <div class="fixed top-0 left-0 w-full h-1.5 z-[100] bg-gray-100/50 backdrop-blur-sm">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-doramed-primary via-cyan-400 to-blue-500 w-0 transition-all duration-100 ease-out shadow-[0_0_10px_rgba(6,147,227,0.5)]"></div>
    </div>

    <main class="relative pt-32 pb-24 min-h-screen bg-[#f8faff]">
        
        <div class="absolute top-0 left-0 w-full h-[600px] bg-gradient-to-b from-blue-50 to-transparent -z-10 pointer-events-none"></div>
        <div class="fixed top-20 right-0 w-[600px] h-[600px] bg-doramed-primary/5 rounded-full blur-[120px] -z-10 pointer-events-none"></div>
        <div class="fixed bottom-0 left-0 w-[500px] h-[500px] bg-cyan-100/10 rounded-full blur-[100px] -z-10 pointer-events-none"></div>

        <article class="container mx-auto px-4 sm:px-6">
            
            <nav class="flex flex-wrap items-center gap-2 text-sm text-gray-500 mb-10 animate-fade-in max-w-5xl mx-auto">
                <a href="/" class="hover:text-doramed-primary transition-colors flex items-center gap-1 opacity-70 hover:opacity-100">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4"><path fill-rule="evenodd" d="M9.293 2.293a1 1 0 011.414 0l7 7A1 1 0 0117 11h-1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-3a1 1 0 00-1-1H9a1 1 0 00-1 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-6H3a1 1 0 01-.707-1.707l7-7z" clip-rule="evenodd" /></svg>
                    خانه
                </a>
                <span class="text-gray-300">/</span>
                <a href="/blog" class="hover:text-doramed-primary transition-colors opacity-70 hover:opacity-100">مجله سلامت</a>
                <span class="text-gray-300">/</span>
                <span class="text-gray-800 font-medium truncate max-w-[200px]">{entry.data.title}</span>
            </nav>

            <header class="text-center mb-14 max-w-4xl mx-auto animate-slide-up">
                <div class="flex items-center justify-center gap-2 mb-6 flex-wrap">
                    {entry.data.tags.map(tag => (
                        <a href={`/blog?category=${tag}`} class="px-4 py-1.5 bg-blue-50/80 border border-blue-100 text-doramed-primary text-xs md:text-sm font-bold rounded-full hover:bg-doramed-primary hover:text-white transition-all duration-300">
                            #{tag}
                        </a>
                    ))}
                </div>
                
                <h1 class="text-3xl md:text-5xl lg:text-6xl font-black text-gray-900 mb-8 leading-[1.3] tracking-tight drop-shadow-sm">
                    {entry.data.title}
                </h1>
                
                <div class="inline-flex flex-wrap items-center justify-center gap-4 md:gap-8 bg-white/80 backdrop-blur-md py-3 px-6 rounded-full border border-gray-200 shadow-sm text-sm text-gray-600">
                    <div class="flex items-center gap-2">
                        <Image src={entry.data.image} alt={entry.data.author} width={36} height={36} class="w-9 h-9 rounded-full object-cover ring-2 ring-blue-100" />
                        <span class="font-bold text-gray-800">{entry.data.author}</span>
                    </div>
                    <div class="w-px h-4 bg-gray-300 hidden md:block"></div>
                    <div class="flex items-center gap-1.5" title="تاریخ انتشار">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                        <span>{formattedDate}</span>
                    </div>
                    <div class="w-px h-4 bg-gray-300 hidden md:block"></div>
                    <div class="flex items-center gap-1.5" title="زمان مطالعه">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-400"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>{readingTime} دقیقه</span>
                    </div>
                </div>
            </header>

            <div class="relative w-full max-w-5xl mx-auto rounded-[2.5rem] overflow-hidden shadow-2xl shadow-blue-900/10 mb-16 group animate-scale-in border-4 border-white bg-gray-50 flex justify-center items-center">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-500 z-10 pointer-events-none"></div>
                <Image 
                    src={entry.data.image} 
                    alt={entry.data.title} 
                    class="max-w-full h-auto max-h-[650px] mx-auto object-contain group-hover:scale-[1.02] transition-transform duration-1000 ease-in-out relative z-0"
                    transition:name={`img-${entry.slug}`} 
                />
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 max-w-7xl mx-auto">
                
                <aside class="hidden lg:block lg:col-span-3">
                    <div class="sticky top-32 space-y-8">
                        <div class="bg-white rounded-3xl p-6 shadow-lg shadow-gray-100 border border-gray-100/50">
                            <h3 class="font-black text-gray-800 mb-5 flex items-center gap-2 text-lg">
                                <span class="w-1.5 h-6 bg-doramed-primary rounded-full"></span>
                                در این مقاله
                            </h3>
                            
                            <nav class="toc-nav max-h-[calc(100vh-250px)] overflow-y-auto custom-scrollbar relative pl-2">
                                <div class="absolute top-0 right-0 h-full w-[2px] bg-gray-100 rounded-full"></div>
                                
                                <div id="toc-indicator" class="absolute right-0 w-[3px] h-6 bg-doramed-primary rounded-full transition-all duration-300 ease-out opacity-0 shadow-[0_0_8px_rgba(6,147,227,0.4)]"></div>

                                <ul class="space-y-0 relative pr-4">
                                    {headings.map((heading, index) => (
                                        <li class={`toc-item transition-all duration-300 ${heading.depth > 2 ? 'mr-3' : ''}`}>
                                            <a 
                                                href={`#${heading.slug}`} 
                                                class="toc-link block py-2 text-sm text-gray-500 hover:text-doramed-primary leading-relaxed transition-all relative"
                                                data-index={index}
                                            >
                                                {heading.text}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </nav>
                        </div>
                        
                        <div class="flex flex-col gap-3 items-center">
                            <span class="text-xs font-bold text-gray-400 mb-1">اشتراک گذاری</span>
                            <button id="copy-link-btn-sidebar" class="w-10 h-10 rounded-full bg-white border border-gray-100 text-gray-500 hover:bg-doramed-primary hover:text-white hover:border-doramed-primary flex items-center justify-center transition-all shadow-sm group relative">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                                <span class="absolute right-12 bg-gray-800 text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">کپی لینک</span>
                            </button>
                            <a href={`https://telegram.me/share/url?url=https://doramed.com/blog/${entry.slug}&text=${entry.data.title}`} target="_blank" class="w-10 h-10 rounded-full bg-white border border-gray-100 text-gray-500 hover:bg-[#229ED9] hover:text-white hover:border-[#229ED9] flex items-center justify-center transition-all shadow-sm">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0 .056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                            </a>
                        </div>
                    </div>
                </aside>

                <div class="col-span-1 lg:col-span-9">
                    <div class="bg-white rounded-[2.5rem] p-6 sm:p-10 md:p-14 shadow-xl shadow-gray-200/60 border border-white/50 relative overflow-hidden">
                        
                        <div class="prose prose-lg md:prose-xl prose-slate max-w-none 
                            prose-p:text-gray-700 prose-p:leading-[2.2] prose-p:mb-8 prose-p:text-justify prose-p:font-light
                            
                            prose-headings:font-black prose-headings:text-gray-900 prose-headings:tracking-tight prose-headings:scroll-mt-32 prose-headings:mb-6
                            prose-h2:text-2xl md:prose-h2:text-3xl prose-h2:border-b prose-h2:border-gray-100 prose-h2:pb-4 prose-h2:mt-12
                            prose-h3:text-xl md:prose-h3:text-2xl prose-h3:text-doramed-primary
                            
                            prose-a:text-doramed-primary prose-a:font-bold prose-a:no-underline prose-a:border-b-2 prose-a:border-doramed-primary/30 hover:prose-a:border-doramed-primary hover:prose-a:bg-blue-50 prose-a:transition-all prose-a:rounded-sm prose-a:px-1
                            
                            prose-img:rounded-[2rem] prose-img:shadow-xl prose-img:shadow-gray-200 prose-img:my-12 prose-img:border prose-img:border-gray-100 prose-img:w-auto prose-img:max-w-full prose-img:mx-auto
                            
                            prose-blockquote:border-r-[6px] prose-blockquote:border-r-doramed-primary prose-blockquote:border-l-0 prose-blockquote:bg-gradient-to-r prose-blockquote:from-blue-50 prose-blockquote:to-white prose-blockquote:py-8 prose-blockquote:px-8 prose-blockquote:rounded-r-none prose-blockquote:rounded-l-2xl prose-blockquote:not-italic prose-blockquote:text-gray-800 prose-blockquote:shadow-sm prose-blockquote:my-10
                            
                            prose-ul:list-disc prose-ul:pr-6 prose-ul:text-gray-700 prose-ul:marker:text-doramed-primary prose-ul:space-y-3
                            prose-ol:list-decimal prose-ol:pr-6 prose-ol:text-gray-700 prose-ol:marker:font-bold prose-ol:marker:text-gray-900 prose-ol:space-y-3
                            
                            prose-li:pl-0
                            
                            prose-strong:text-gray-900 prose-strong:font-extrabold prose-strong:bg-gray-100 prose-strong:px-1 prose-strong:rounded">
                            
                            <Content />
                        
                        </div>

                        <div class="mt-20 pt-12 border-t border-gray-100">
                            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 bg-[#f8faff] p-8 rounded-[2rem] border border-blue-50/50">
                                <div class="shrink-0 relative">
                                    <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full p-1 bg-white shadow-md">
                                        <Image src={entry.data.image} alt={entry.data.author} width={100} height={100} class="w-full h-full rounded-full object-cover" />
                                    </div>
                                    <div class="absolute -bottom-2 -right-2 bg-doramed-primary text-white text-[10px] font-bold px-2 py-1 rounded-full border-2 border-white">نویسنده</div>
                                </div>
                                <div class="text-center sm:text-right flex-grow">
                                    <h4 class="text-xl font-bold text-gray-900 mb-2">{entry.data.author}</h4>
                                    <p class="text-gray-500 text-sm leading-7 mb-4">
                                        تلاش من ارائه محتوای علمی دقیق و به‌روز برای کمک به شما در مسیر سلامتی است. امیدوارم این مطلب برایتان مفید بوده باشد.
                                    </p>
                                    <div class="flex justify-center sm:justify-start gap-2">
                                        <button class="text-xs font-bold text-doramed-primary border border-doramed-primary/20 bg-white px-4 py-2 rounded-xl hover:bg-doramed-primary hover:text-white transition-colors">مشاهده سایر مقالات</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            {relatedPosts.length > 0 && (
                <section class="mt-24 mb-16 max-w-7xl mx-auto border-t border-gray-200 pt-16">
                    <div class="flex items-center justify-between mb-10">
                        <div class="flex items-center gap-3">
                            <div class="h-8 w-1.5 bg-doramed-primary rounded-full"></div>
                            <h3 class="text-gray-900 font-black text-2xl md:text-3xl">ادامه مطالعه...</h3>
                        </div>
                        <a href="/blog" class="hidden md:inline-flex items-center gap-1 text-doramed-primary font-bold hover:gap-2 transition-all">
                            مشاهده همه
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                        </a>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        {relatedPosts.map(post => (
                            <a href={`/blog/${post.slug}`} class="group bg-white rounded-[2rem] p-4 shadow-lg shadow-gray-100 hover:shadow-2xl hover:shadow-doramed-primary/10 hover:-translate-y-2 transition-all duration-500 border border-white">
                                <div class="relative h-56 rounded-[1.5rem] overflow-hidden mb-5">
                                    <div class="absolute inset-0 bg-doramed-primary/20 opacity-0 group-hover:opacity-100 transition-opacity z-10 mix-blend-multiply"></div>
                                    <Image src={post.data.image} alt={post.data.title} width={400} height={300} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                                    <span class="absolute bottom-3 right-3 bg-white/95 backdrop-blur px-3 py-1.5 rounded-xl text-xs font-bold text-gray-900 shadow-sm z-20">
                                        {post.data.tags[0]}
                                    </span>
                                </div>
                                <h4 class="font-bold text-lg text-gray-900 mb-3 line-clamp-2 leading-snug group-hover:text-doramed-primary transition-colors px-1">
                                    {post.data.title}
                                </h4>
                                <div class="flex items-center justify-between text-xs text-gray-400 px-1 pb-1">
                                    <time>{post.data.pubDate.toLocaleDateString('fa-IR')}</time>
                                    <span class="flex items-center gap-1 text-gray-500 group-hover:translate-x-[-4px] transition-transform">
                                        خواندن
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3 rotate-180"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}

        </article>
    </main>
    
    <Footer />
</Layout>

<script>
    // تابعی که تمام لاجیک صفحه را اجرا می‌کند (برای سازگاری با View Transitions)
    const initPageScripts = () => {
        
        // 1. Progress Bar Logic
        const progressBar = document.getElementById("progress-bar");
        const updateProgress = () => {
            if (!progressBar) return;
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            progressBar.style.width = scrolled + "%";
        };
        
        // حذف لیسنر قبلی برای جلوگیری از تکرار (در صورت وجود)
        window.removeEventListener('scroll', updateProgress);
        // اضافه کردن لیسنر جدید
        window.addEventListener('scroll', updateProgress);


        // 2. Copy Link Logic (Sidebar)
        const copyBtnSidebar = document.getElementById('copy-link-btn-sidebar');
        if (copyBtnSidebar) {
            // کلون کردن دکمه برای حذف ایونت لیسنرهای قبلی (ترفند تمیزکاری)
            const newBtn = copyBtnSidebar.cloneNode(true);
            copyBtnSidebar.parentNode.replaceChild(newBtn, copyBtnSidebar);

            newBtn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(window.location.href);
                    const tooltip = newBtn.querySelector('span');
                    const originalText = tooltip.innerText;
                    tooltip.innerText = "کپی شد!";
                    tooltip.classList.remove('opacity-0');
                    setTimeout(() => {
                        tooltip.innerText = originalText;
                        tooltip.classList.add('opacity-0');
                    }, 2000);
                } catch (err) {
                    console.error('Failed to copy: ', err);
                }
            });
        }


        // 3. Active Table of Contents Logic (Fixed for Navigation)
        const indicator = document.getElementById('toc-indicator');
        const tocLinks = document.querySelectorAll('.toc-link');
        const sections = document.querySelectorAll('h2[id], h3[id]');

        if (indicator && tocLinks.length > 0 && sections.length > 0) {
            
            const observerCallback = (entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        const activeLink = document.querySelector(`.toc-link[href="#${id}"]`);

                        if (activeLink) {
                            tocLinks.forEach(link => {
                                link.classList.remove('text-doramed-primary', 'font-bold', 'translate-x-1');
                                link.classList.add('text-gray-500');
                            });

                            activeLink.classList.remove('text-gray-500');
                            activeLink.classList.add('text-doramed-primary', 'font-bold', 'translate-x-1');

                            const offsetTop = activeLink.offsetTop;
                            const height = activeLink.offsetHeight;
                            
                            indicator.style.opacity = '1';
                            // تنظیم دقیق موقعیت
                            indicator.style.top = `${offsetTop + (height / 2) - 12}px`; 
                        }
                    }
                });
            };

            // قطع کردن آبزرور قبلی اگر وجود دارد
            if (window.tocObserver) {
                window.tocObserver.disconnect();
            }

            window.tocObserver = new IntersectionObserver(observerCallback, {
                rootMargin: '-100px 0px -60% 0px',
                threshold: 0.1
            });

            sections.forEach(section => window.tocObserver.observe(section));
        }
    };

    document.addEventListener('astro:page-load', initPageScripts);
</script>

<style>
    @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slide-up { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes scale-in { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
    
    .animate-fade-in { animation: fade-in 0.8s ease-out forwards; }
    .animate-slide-up { animation: slide-up 0.8s ease-out 0.2s forwards; opacity: 0; }
    .animate-scale-in { animation: scale-in 1s ease-out 0.4s forwards; opacity: 0; }
    
    html { scroll-behavior: smooth; }

    /* Custom Scrollbar for TOC */
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #e5e7eb; border-radius: 20px; }
    .custom-scrollbar:hover::-webkit-scrollbar-thumb { background-color: #d1d5db; }
</style>