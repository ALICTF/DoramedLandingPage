---
// src/pages/kiosk/hse-pro.astro
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

// کامپوننت‌های اختصاصی HSE Pro (تم روشن)
import HseHero from "../../components/kiosk/hse-pro/HseHero.astro";
import HseLogos from "../../components/kiosk/hse-pro/HseLogos.astro";
import HseWhy from "../../components/kiosk/hse-pro/HseWhy.astro";
import HseFeatures from "../../components/kiosk/hse-pro/HseFeatures.astro";
import HseAI from "../../components/kiosk/hse-pro/HseAI.astro";
import HseHowItWorks from "../../components/kiosk/hse-pro/HseHowItWorks.astro";
import HseTarget from "../../components/kiosk/hse-pro/HseTarget.astro";
import HseScenarios from "../../components/kiosk/hse-pro/HseScenarios.astro";
import HseOutputs from "../../components/kiosk/hse-pro/HseOutputs.astro";
import HseTestimonials from "../../components/kiosk/hse-pro/HseTestimonials.astro";
import KioskShowcase from "../../components/kiosk/shared/KioskShowcase.astro";
import kioskHseImg from "../../assets/kiosk/kiosk-hse-white.png";
import HseCases from "../../components/kiosk/hse-pro/HseCases.astro";
import KioskIndustries from "../../components/kiosk/shared/KioskIndustries.astro";
import KioskDashboards from "../../components/kiosk/shared/KioskDashboards.astro";
import HseFAQ from "../../components/kiosk/hse-pro/HseFAQ.astro";
import HseCTA from "../../components/kiosk/hse-pro/HseCTA.astro";
import HseStickyCTA from "../../components/kiosk/hse-pro/HseStickyCTA.astro";
import HseReveal from "../../components/kiosk/hse-pro/HseReveal.astro";

const pageTitle = "HSE Pro | کیوسک هوشمند پایش سلامت کارکنان و صنایع - دورامد";
const pageDescription = "کیوسک هوشمند پایش سلامت دورامد، راهکاری جامع برای غربالگری سریع، پایش سلامت شغلی، معاینات دوره‌ای و مدیریت داده‌محور سلامت کارکنان در محیط‌های صنعتی و سازمانی.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Navbar />

  <main class="bg-white text-slate-800 overflow-hidden pt-20">

    <!-- ۱) هیرو (ثابت) -->
    <HseHero />

    <!-- ۲) اعتمادسازی: لوگوی مشتریان -->
    <HseLogos />

    <!-- ۳) چالش و ارزش کسب‌وکار (چرا HSE Pro) -->
    <div class="reveal-on-scroll"><HseWhy /></div>

    <!-- ۴) قابلیت‌ها و تست‌های دستگاه (کاربرد اصلی محصول) -->
    <div class="reveal-on-scroll"><HseFeatures /></div>

    <!-- ۵) معرفی فیزیکی دستگاه -->
    <div class="reveal-on-scroll">
      <KioskShowcase
        image={kioskHseImg}
        title="کیوسک HSE Pro از نزدیک"
        description="یک ایستگاه سلامت شغلی یکپارچه و تمام‌فارسی که شش تست حیاتی، تحلیل هوش مصنوعی و پرونده سلامت کارکنان را در یک دستگاه گرد هم می‌آورد."
        bg="slate"
      />
    </div>

    <!-- ۶) سناریوهای واقعی کاربرد در صنایع -->
    <div class="reveal-on-scroll"><HseScenarios /></div>

    <!-- ۷) تمایز کلیدی: هوش مصنوعی -->
    <div class="reveal-on-scroll"><HseAI /></div>

    <!-- ۸) نحوه کارکرد -->
    <div class="reveal-on-scroll"><HseHowItWorks /></div>

    <!-- ۹) خروجی‌ها و گزارش‌های مدیریتی -->
    <div class="reveal-on-scroll"><HseOutputs /></div>

    <!-- ۱۰) داشبورد کاربر و مدیریت (ارزش افزوده‌ی کلیدی B2B) -->
    <div class="reveal-on-scroll"><KioskDashboards bg="white" /></div>

    <!-- ۱۱) این محصول برای چه سازمان‌هایی است -->
    <div class="reveal-on-scroll"><HseTarget /></div>

    <!-- ۱۲) رضایت مشتریان -->
    <div class="reveal-on-scroll"><HseTestimonials /></div>

    <!-- ۱۳) نمونه استقرار / مشتریان -->
    <div class="reveal-on-scroll"><HseCases /></div>

    <!-- ۱۴) سایر کاربردها / صنایع -->
    <div class="reveal-on-scroll"><KioskIndustries bg="white" /></div>

    <!-- ۱۵) سوالات متداول -->
    <div class="reveal-on-scroll"><HseFAQ /></div>

    <!-- ۱۶) فراخوان نهایی -->
    <div class="reveal-on-scroll"><HseCTA /></div>

  </main>

  <Footer />

  <HseStickyCTA />
  <HseReveal />
</Layout>
