---
// src/components/Footer.astro
import SocialIcon from "./ui/SocialIcon.astro";
import { quickLinks, footerSocials, contact } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-doramed-darker text-doramed-gray pt-16 pb-8 border-t border-doramed-muted/20 mt-auto">
    <div class="container mx-auto px-6">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 mb-12 text-center md:text-right">
            
            <div class="flex flex-col items-center md:items-start">
                <div class="flex items-center gap-2 mb-4">
                     <span class="text-2xl font-bold text-doramed-white">دورامد</span>
                </div>
                <p class="leading-loose text-sm text-justify md:text-right max-w-sm md:max-w-none mx-auto md:mx-0">
                    ما در دورامد تلاش می‌کنیم تا با تلفیق دانش پزشکی و هوش مصنوعی، راهکارهای نوآورانه‌ای برای پایش سلامت و ارتقای کیفیت زندگی ارائه دهیم. محصولات ما پلی میان تکنولوژی و سلامتی هستند.
                </p>
            </div>

            <div class="flex flex-col items-center md:items-start">
                <h3 class="text-doramed-white font-bold text-lg mb-4">دسترسی سریع</h3>
                <nav>
                    <ul class="space-y-3 w-full max-w-xs md:max-w-none">
                        {quickLinks.map(link => (
                            <li>
                                <a href={link.href} class="hover:text-doramed-primary transition duration-300 flex items-center justify-center md:justify-start gap-2">
                                    <span class="text-xs text-doramed-primary">❯</span>
                                    {link.text}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
            </div>

            <div class="flex flex-col items-center md:items-start">
                <h3 class="text-doramed-white font-bold text-lg mb-4">راه‌های ارتباطی</h3>
                <address class="not-italic space-y-4 w-full max-w-xs md:max-w-none">
                    <div class="flex items-start justify-center md:justify-start gap-3 text-center md:text-right">
                        <span class="text-doramed-primary mt-1 shrink-0">📍</span>
                        <span>{contact.address}</span>
                    </div>

                    <div class="flex items-center justify-center md:justify-start gap-3">
                        <span class="text-doramed-primary shrink-0">📞</span>
                        <a href={contact.phoneHref} class="hover:text-doramed-white transition" dir="ltr">{contact.phone}</a>
                    </div>

                    <div class="flex items-center justify-center md:justify-start gap-3">
                        <span class="text-doramed-primary shrink-0">✉️</span>
                        <a href={`mailto:${contact.email}`} class="hover:text-doramed-white transition">{contact.email}</a>
                    </div>

                    <div class="flex items-center justify-center md:justify-start gap-3">
                        <span class="text-doramed-primary shrink-0">🌐</span>
                        <a href={contact.website} target="_blank" rel="noopener noreferrer" class="hover:text-doramed-white transition">doramed.ir</a>
                    </div>
                </address>
            </div>

        </div>

        <div class="border-t border-doramed-muted/20 my-8"></div>

        <div class="flex flex-col-reverse md:flex-row justify-between items-center gap-6 text-sm">
            <p class="text-center md:text-right">تمامی حقوق برای شرکت <span class="text-doramed-white font-bold">نوین مدیا (دورامد)</span> محفوظ است © {year}</p>
            
            <div class="flex gap-6">
                {footerSocials.map(social => (
                    <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`صفحه ${social.name} دورامد`}
                        class="text-doramed-gray hover:text-doramed-primary transition transform hover:scale-110"
                    >
                        <SocialIcon name={social.icon} class="w-6 h-6" />
                    </a>
                ))}
            </div>
        </div>
    </div>
</footer>