---
// src/components/KioskCTA.astro
---

<section class="py-24 relative overflow-hidden bg-doramed-darker">
  
  <div class="absolute inset-0 bg-gradient-to-br from-doramed-primary/90 to-doramed-darker z-0"></div>
  <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-20 mix-blend-overlay z-0 pointer-events-none"></div>

  <div class="absolute -top-40 -right-40 w-[600px] h-[600px] bg-cyan-400/30 rounded-full blur-[120px] pointer-events-none animate-pulse"></div>
  <div class="absolute -bottom-40 -left-40 w-[600px] h-[600px] bg-doramed-primary/50 rounded-full blur-[120px] pointer-events-none animate-pulse" style="animation-delay: 2s;"></div>

  <div class="container mx-auto px-4 sm:px-6 relative z-10 text-center">
    
    <div class="max-w-5xl mx-auto bg-white/10 backdrop-blur-2xl border border-white/20 rounded-[3rem] p-10 md:p-16 lg:p-20 shadow-2xl overflow-hidden relative group">
      
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

      <div class="inline-flex items-center justify-center w-20 h-20 mb-8 rounded-full bg-white/10 border border-white/20 shadow-inner backdrop-blur-md">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-10 h-10 text-cyan-300">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>

      <h2 class="text-3xl md:text-5xl lg:text-6xl font-black text-white mb-8 leading-tight tracking-tight">
        آماده‌ی ورود به <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-emerald-300">آینده‌ی سلامت</span> هستید؟
      </h2>
      <p class="text-cyan-50 text-lg md:text-xl lg:text-2xl mb-12 leading-relaxed max-w-3xl mx-auto font-light">
        پس از انجام چکاپ در کیوسک‌های دورامد، پرونده هوشمند و برنامه‌های اختصاصی شما در داشبورد کاربری‌تان منتظر شماست.
      </p>

      <div class="flex flex-col items-center gap-6">
        
        <a href="http://kiosk.doramed.ir/subusers/login" target="_blank" rel="noopener noreferrer" class="relative inline-flex items-center justify-center gap-4 px-10 py-5 bg-white text-doramed-darker font-extrabold text-lg md:text-xl rounded-2xl shadow-[0_0_40px_rgba(255,255,255,0.2)] hover:shadow-[0_0_60px_rgba(6,182,212,0.5)] hover:-translate-y-1 active:scale-95 transition-all duration-300 group/btn overflow-hidden">
          <span class="relative z-10">ورود به پنل کاربری</span>
          
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-6 h-6 text-doramed-primary group-hover/btn:-translate-x-2 transition-transform relative z-10">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          
          <div class="absolute inset-0 h-full w-full bg-gradient-to-r from-transparent via-cyan-100/60 to-transparent -translate-x-full group-hover/btn:animate-[shimmer_1.5s_infinite]"></div>
        </a>

        <div class="flex items-center gap-2 text-cyan-200/80 text-sm font-medium mt-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
          </svg>
          <span>حریم خصوصی و امنیت داده‌های پزشکی شما تضمین شده است</span>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  /* انیمیشن اختصاصی برای افکت براق شدن دکمه */
  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
</style>