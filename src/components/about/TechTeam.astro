---
// src/components/about/TechTeam.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Member {
    name: string;
    role: string;
    image: ImageMetadata;
    bio: string;
    skills?: string[];
    linkedin?: string; // اضافه کردن ویژگی لینکدین (اختیاری)
}

interface Props {
    team: Member[];
}

const { team } = Astro.props;
---

<section class="container mx-auto px-4 mb-24 relative">
    
    <div class="text-center mb-16">
        <span class="text-doramed-primary font-bold text-xs uppercase tracking-wider bg-blue-50 px-3 py-1 rounded-full mb-3 inline-block">هسته فنی</span>
        <h2 class="text-3xl md:text-4xl font-black text-gray-900">تیم فنی و مهندسی</h2>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8">
        {team.map((member) => (
            <div class="group relative bg-white rounded-[2.5rem] p-8 border border-gray-100 shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 w-full sm:w-96 min-h-[550px] flex flex-col items-center justify-between overflow-hidden">
                
                {member.linkedin && (
                    <a href={member.linkedin} target="_blank" class="absolute top-6 left-6 z-20 flex items-center justify-center w-10 h-10 bg-gray-50 text-gray-400 rounded-full hover:bg-[#0077b5] hover:text-white transition-all duration-300 shadow-sm hover:shadow-md hover:scale-110" aria-label="LinkedIn">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                        </svg>
                    </a>
                )}

                <div class="relative w-44 h-44 mx-auto mb-6 rounded-full overflow-hidden shadow-lg border-[6px] border-white group-hover:border-blue-50 transition-all duration-500 shrink-0 mt-4">
                    <Image 
                        src={member.image} 
                        alt={member.name} 
                        width={300} 
                        height={300} 
                        class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 scale-105 group-hover:scale-100 transition-all duration-500" 
                    />
                </div>

                <div class="text-center flex flex-col items-center flex-grow w-full">
                    <h3 class="text-xl font-black text-gray-900 mb-3 group-hover:text-doramed-primary transition-colors h-14 flex items-center justify-center">
                        {member.name}
                    </h3>
                    
                    <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-5 bg-blue-50 inline-block px-4 py-1.5 rounded-full">
                        {member.role}
                    </p>

                    <p class="text-sm text-gray-500 leading-8 text-justify px-2 line-clamp-5 group-hover:line-clamp-none transition-all duration-500">
                        {member.bio}
                    </p>
                </div>
            </div>
        ))}
    </div>
</section>