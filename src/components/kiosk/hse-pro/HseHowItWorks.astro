---
// src/components/kiosk/hse-pro/HseHowItWorks.astro
// چطور کار می‌کند؟ - فرآیند غربالگری در ۳ گام
import { Icon } from "astro-icon/components";

const steps = [
    { n: "۱", title: "احراز هویت کارمند", desc: "کارمند با کارت پرسنلی یا کد ملی روی صفحه لمسی وارد سیستم می‌شود.", icon: "lucide:id-card" },
    { n: "۲", title: "غربالگری خودکار سلامت", desc: "کیوسک در چند دقیقه علائم حیاتی و شاخص‌های سلامت شغلی را ثبت می‌کند.", icon: "lucide:stethoscope" },
    { n: "۳", title: "ثبت در پرونده و داشبورد", desc: "داده‌ها در پرونده سلامت کارمند و داشبورد مدیریتی HSE ذخیره و تحلیل می‌شود.", icon: "lucide:layout-dashboard" },
];
---

<section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6">

        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-doramed-primary/8 text-doramed-primary text-sm font-bold mb-5">
                <Icon name="lucide:play-circle" class="w-4 h-4" />
                چطور کار می‌کند؟
            </span>
            <h2 class="text-2xl md:text-4xl font-black text-slate-800 mb-4">
                غربالگری سلامت در <span class="text-doramed-primary">سه گام ساده</span>
            </h2>
            <p class="text-slate-500 text-base md:text-lg leading-relaxed">
                بدون نیاز به نیروی متخصص؛ سریع، خودکار و قابل پایش برای کل سازمان.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-5xl mx-auto">
            {steps.map(step => (
                <div class="group relative bg-gradient-to-b from-slate-50 to-white rounded-3xl border border-slate-100 p-8 text-center hover:shadow-[0_15px_40px_rgba(2,62,138,0.1)] hover:-translate-y-1 transition-all duration-300">
                    <span class="absolute top-5 right-5 text-5xl font-black text-doramed-primary/10 leading-none">{step.n}</span>
                    <div class="w-16 h-16 mx-auto mb-5 rounded-2xl bg-doramed-primary/10 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white transition-colors duration-300">
                        <Icon name={step.icon} class="w-8 h-8" />
                    </div>
                    <h3 class="text-lg font-black text-slate-800 mb-2 group-hover:text-doramed-primary transition-colors">{step.title}</h3>
                    <p class="text-slate-500 text-sm leading-relaxed">{step.desc}</p>
                </div>
            ))}
        </div>

    </div>
</section>
