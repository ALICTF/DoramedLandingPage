---
// src/components/kiosk/hse-pro/HseFeatures.astro
// تم روشن - تست‌ها و سنسورهای کیوسک HSE Pro (۶ تست، با تمرکز صنعتی)
import { Icon } from "astro-icon/components";

// برای HSE: نوار قلب، فشار خون و بینایی‌سنجی در طب کار حساس‌ترند، اول می‌آیند.
const features = [
    { title: "نوار قلب (ECG)", desc: "غربالگری ریتم قلب کارکنان مشاغل سخت و پرریسک پیش از شیفت.", icon: "lucide:activity" },
    { title: "فشار خون", desc: "پایش فشار خون و ضربان قلب؛ شاخص کلیدی سلامت شغلی و طب کار.", icon: "lucide:gauge" },
    { title: "بینایی‌سنجی", desc: "سنجش بینایی برای رانندگان، اپراتورها و مشاغل نیازمند دقت بصری.", icon: "lucide:eye" },
    { title: "اکسیژن خون (SpO2)", desc: "سنجش اشباع اکسیژن خون در محیط‌های صنعتی و فضاهای بسته.", icon: "lucide:droplet" },
    { title: "آنالیز ترکیب بدن", desc: "اندازه‌گیری چربی، عضله و شاخص توده بدنی برای ارزیابی آمادگی جسمانی.", icon: "lucide:scan-line" },
    { title: "قند خون", desc: "غربالگری قند خون برای شناسایی زودهنگام دیابت در کارکنان.", icon: "lucide:test-tube" },
    { title: "اسپیرومتری", desc: "سنجش ظرفیت و عملکرد ریه؛ ضروری برای مشاغل در معرض گرد و غبار و گازها.", icon: "lucide:wind" },
    { title: "آدیومتری", desc: "سنجش شنوایی کارکنان در محیط‌های پر سر و صدا و مشاغل پرریسک صنعتی.", icon: "lucide:ear" },
];
---

<section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6">

        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-doramed-primary/8 text-doramed-primary text-sm font-bold mb-5">
                <Icon name="lucide:cpu" class="w-4 h-4" />
                سنسورهای کیوسک
            </span>
            <h2 class="text-2xl md:text-4xl font-black text-slate-800 mb-4">
                ۸ تست سلامت در یک <span class="text-doramed-primary">کیوسک</span>
            </h2>
            <p class="text-slate-500 text-base md:text-lg leading-relaxed">
کارمند در چند دقیقه و با راهنمایی اپراتور تمام تست‌ها را انجام می‌دهد و نتایج به‌صورت خودکار در پرونده سلامت سازمانی ثبت می‌شود.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {features.map(f => (
                <div class="group bg-white rounded-2xl border border-slate-100 p-6 flex items-start gap-4 text-right shadow-[0_8px_25px_rgba(15,27,42,0.04)] hover:shadow-[0_12px_30px_rgba(2,62,138,0.12)] hover:border-doramed-primary/30 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-14 h-14 shrink-0 rounded-2xl bg-doramed-primary/8 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white transition-colors duration-300">
                        <Icon name={f.icon} class="w-7 h-7" />
                    </div>
                    <div>
                        <h3 class="text-base font-black text-slate-800 mb-1.5 group-hover:text-doramed-primary transition-colors">{f.title}</h3>
                        <p class="text-slate-500 text-sm leading-relaxed">{f.desc}</p>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>
