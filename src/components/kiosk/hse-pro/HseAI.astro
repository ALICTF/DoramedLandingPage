---
// src/components/kiosk/hse-pro/HseAI.astro
// گزارش تجمیعی هوشمند سلامت با هوش مصنوعی (بخش تمایز اصلی)
import { Icon } from "astro-icon/components";

const flow = [
    { title: "تحلیل هوشمند نتایج", desc: "هوش مصنوعی نتایج هر شش تست را تحلیل و وضعیت سلامت کارمند را ارزیابی می‌کند.", icon: "lucide:brain-circuit" },
    { title: "برنامه سلامت اختصاصی", desc: "بر اساس داده‌ها، برنامه غذایی، تمرینی و مکملی متناسب با شرایط شغلی فرد ارائه می‌شود.", icon: "lucide:clipboard-list" },
    { title: "ارجاع به پزشک متخصص", desc: "در صورت شناسایی ریسک یا مشکل، کارمند به‌صورت خودکار به پزشک متخصص ارجاع داده می‌شود.", icon: "lucide:stethoscope" },
];
---

<section class="py-16 lg:py-24 bg-white relative overflow-hidden">
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-doramed-primary/5 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 relative z-10">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

            <!-- متن معرفی -->
            <div class="text-center lg:text-right">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-doramed-primary/8 text-doramed-primary text-sm font-bold mb-5">
                    <Icon name="lucide:sparkles" class="w-4 h-4" />
                    قلب هوشمند کیوسک
                </span>
                <h2 class="text-2xl md:text-4xl font-black text-slate-800 mb-5 leading-snug">
                    گزارش تجمیعی هوشمند سلامت با <span class="text-doramed-primary">هوش مصنوعی</span>
                </h2>
                <p class="text-slate-500 text-base md:text-lg leading-loose mb-6">
                    کیوسک فقط تست نمی‌گیرد؛ نتایج همه‌ی تست‌ها را به بک‌اند می‌فرستد و یک <strong class="text-slate-700">پرونده سلامت سازمانی</strong> برای هر کارمند تشکیل می‌دهد. سپس هوش مصنوعی داده‌ها را تحلیل کرده و یک گزارش جامع و عملی ارائه می‌دهد.
                </p>
                <p class="text-slate-500 text-sm md:text-base leading-loose">
                    این گزارش شامل برنامه غذایی، تمرینی و مکملی شخصی‌سازی شده است و در صورت وجود ریسک سلامتی، کارمند را به پزشک متخصص ارجاع می‌دهد؛ مبنایی داده‌محور برای تصمیم‌گیری واحد HSE و طب کار.
                </p>
            </div>

            <!-- مراحل فرآیند AI -->
            <div class="space-y-4">
                {flow.map((step, i) => (
                    <div class="group flex items-start gap-4 bg-slate-50 rounded-2xl border border-slate-100 p-5 hover:bg-white hover:shadow-[0_12px_30px_rgba(2,62,138,0.1)] hover:border-doramed-primary/30 transition-all duration-300">
                        <div class="relative w-12 h-12 shrink-0 rounded-xl bg-doramed-primary/10 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white transition-colors duration-300">
                            <Icon name={step.icon} class="w-6 h-6" />
                            <span class="absolute -top-2 -right-2 w-6 h-6 rounded-full bg-doramed-primary text-white text-xs font-black flex items-center justify-center ring-4 ring-white">{i + 1}</span>
                        </div>
                        <div class="text-right">
                            <h3 class="text-base font-black text-slate-800 mb-1 group-hover:text-doramed-primary transition-colors">{step.title}</h3>
                            <p class="text-slate-500 text-sm leading-relaxed">{step.desc}</p>
                        </div>
                    </div>
                ))}
            </div>

        </div>
    </div>
</section>
