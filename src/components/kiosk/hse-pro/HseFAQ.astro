---
// src/components/kiosk/hse-pro/HseFAQ.astro
// سوالات متداول - آکاردئون
import { Icon } from "astro-icon/components";

const faqs = [
    { q: "نصب و راه‌اندازی کیوسک در سازمان چقدر طول می‌کشد؟", a: "پس از نیازسنجی و نهایی شدن سفارش، کیوسک آماده‌سازی و در محل سازمان شما نصب و پیکربندی می‌شود. آموزش کامل کار با دستگاه به تیم HSE یا پزشک سازمان ارائه می‌گردد." },
    { q: "هزینه استفاده از HSE Pro چقدر است؟", a: "قیمت متناسب با تعداد کارکنان، تعداد تست‌ها و ساختار سازمان شماست. برای دریافت پیشنهاد اختصاصی و مشاوره با واحد فروش دورامد تماس بگیرید." },
    { q: "آیا برای کار با دستگاه به اپراتور نیاز است؟", a: "بله. غربالگری با حضور یک اپراتور آموزش‌دیده انجام می‌شود تا فرآیند برای هر کارمند دقیق و ایمن باشد. آموزش کامل کار با دستگاه به تیم HSE یا پزشک سازمان ارائه می‌شود." },
    { q: "امکان افزودن تست‌های جدید مثل آدیومتری وجود دارد؟", a: "بله. پلتفرم توسعه‌پذیر است و بسته به نیاز سازمان می‌توان سنسورها و تست‌های جدید مانند آدیومتری و اسپیرومتری را به سیستم اضافه کرد." },
    { q: "داده‌های سلامت کارکنان چگونه محافظت می‌شود؟", a: "داده‌ها به‌صورت امن در پرونده سلامت دیجیتال هر کارمند نگهداری می‌شود و دسترسی به آن‌ها از طریق داشبورد مدیریتی و سطوح دسترسی کنترل‌شده انجام می‌گیرد." },
    { q: "آیا گزارش‌ها قابل اتصال به نرم‌افزارهای سازمانی هستند؟", a: "بله. خروجی اکسل و امکان اتصال از طریق API به نرم‌افزارهای منابع انسانی و سلامت سازمان فراهم است." },
];
---

<section class="py-14 lg:py-20 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6">

        <div class="text-center max-w-2xl mx-auto mb-10">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-doramed-primary/8 text-doramed-primary text-sm font-bold mb-5">
                <Icon name="lucide:help-circle" class="w-4 h-4" />
                سوالات متداول
            </span>
            <h2 class="text-2xl md:text-4xl font-black text-slate-800">
                هر آنچه باید <span class="text-doramed-primary">بدانید</span>
            </h2>
        </div>

        <div class="faq-accordion max-w-3xl mx-auto space-y-2.5">
            {faqs.map(faq => (
                <div class="faq-item bg-slate-50 rounded-2xl border border-slate-100 shadow-[0_4px_15px_rgba(15,27,42,0.04)] overflow-hidden transition-colors duration-300 hover:border-doramed-primary/20">
                    <button type="button" class="faq-trigger w-full flex items-center justify-between gap-4 p-4 cursor-pointer text-right select-none" aria-expanded="false">
                        <span class="font-black text-slate-800 text-sm md:text-base">{faq.q}</span>
                        <span class="faq-icon w-8 h-8 shrink-0 rounded-full bg-doramed-primary/8 flex items-center justify-center text-doramed-primary transition-all duration-300">
                            <Icon name="lucide:chevron-down" class="w-5 h-5 transition-transform duration-300" />
                        </span>
                    </button>
                    <div class="faq-panel grid grid-rows-[0fr] transition-all duration-300 ease-out">
                        <div class="overflow-hidden">
                            <p class="text-slate-500 text-sm leading-loose text-right px-4 pb-4">{faq.a}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>

<script>
    function initFaqAccordion() {
        document.querySelectorAll<HTMLElement>(".faq-accordion").forEach(acc => {
            const items = acc.querySelectorAll<HTMLElement>(".faq-item");
            items.forEach(item => {
                const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger");
                const panel = item.querySelector<HTMLElement>(".faq-panel");
                const icon = item.querySelector<HTMLElement>(".faq-icon");
                if (!trigger || !panel || !icon) return;

                trigger.addEventListener("click", () => {
                    const isOpen = panel.classList.contains("grid-rows-[1fr]");

                    // بستن همه‌ی آیتم‌ها (رفتار آکاردئون)
                    items.forEach(other => {
                        const p = other.querySelector<HTMLElement>(".faq-panel");
                        const t = other.querySelector<HTMLButtonElement>(".faq-trigger");
                        const ic = other.querySelector<HTMLElement>(".faq-icon");
                        const cv = ic?.querySelector("svg");
                        p?.classList.remove("grid-rows-[1fr]");
                        p?.classList.add("grid-rows-[0fr]");
                        t?.setAttribute("aria-expanded", "false");
                        ic?.classList.remove("bg-doramed-primary", "text-white");
                        ic?.classList.add("bg-doramed-primary/8", "text-doramed-primary");
                        cv?.classList.remove("rotate-180");
                    });

                    // باز کردن همین آیتم اگر بسته بود
                    if (!isOpen) {
                        panel.classList.remove("grid-rows-[0fr]");
                        panel.classList.add("grid-rows-[1fr]");
                        trigger.setAttribute("aria-expanded", "true");
                        icon.classList.remove("bg-doramed-primary/8", "text-doramed-primary");
                        icon.classList.add("bg-doramed-primary", "text-white");
                        icon.querySelector("svg")?.classList.add("rotate-180");
                    }
                });
            });
        });
    }

    document.addEventListener("astro:page-load", initFaqAccordion);
</script>
