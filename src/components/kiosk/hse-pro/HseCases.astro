---
// src/components/kiosk/hse-pro/HseCases.astro
// تم روشن - نمونه استقرار / مشتریان (۴ کارت عکس + بج)
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import imgCable from "../../../assets/kiosk/sections/hse-cable.jpg";
import imgGas from "../../../assets/kiosk/sections/hse-gas.jpg";
import imgMunicipal from "../../../assets/kiosk/sections/hse-municipal.jpg";
import imgIndustry from "../../../assets/kiosk/sections/hse-industry.jpg";

// logo: مسیر لوگوی شرکت (در صورت موجود بودن). فعلاً جای‌نگه‌دار با حرف اول نام.
const cases = [
    { name: "کارخانه سیم کابل افلاک", desc: "استقرار در واحد حساس پایش سلامت کارکنان و خدمات HSE.", icon: "lucide:cable", img: imgCable, logo: "اف" },
    { name: "شرکت گاز", desc: "استقرار در شرکت‌های گاز کشوری و استانی.", icon: "lucide:flame", img: imgGas, logo: "گ" },
    { name: "شهرداری‌ها", desc: "استقرار در سازمان‌های شهرداری و خدمات شهری.", icon: "lucide:building-2", img: imgMunicipal, logo: "ش" },
    { name: "مجموعه‌های صنعتی", desc: "استقرار در صنایع بزرگ و واحدهای تولیدی.", icon: "lucide:factory", img: imgIndustry, logo: "ص" },
];
---

<section class="py-16 lg:py-24 bg-white">
    <div class="container mx-auto px-4 sm:px-6">

        <h2 class="text-2xl md:text-4xl font-black text-slate-800 text-center mb-12 md:mb-16">
            نمونه استقرار / <span class="text-doramed-primary">مشتریان</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            {cases.map(item => (
                <div class="group bg-white rounded-3xl border border-slate-100 p-3 shadow-[0_8px_25px_rgba(15,27,42,0.05)] hover:shadow-[0_15px_40px_rgba(2,62,138,0.12)] hover:-translate-y-1 transition-all duration-300">
                    <!-- عکس محل استقرار + لوگوی شرکت -->
                    <div class="relative w-full h-32 rounded-2xl overflow-hidden bg-slate-100 mb-3">
                        <Image src={item.img} alt={item.name} width={400} height={300} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/30 to-transparent pointer-events-none"></div>
                        <!-- لوگوی شرکت (جای‌نگه‌دار) -->
                        <div class="absolute bottom-2 right-2 w-12 h-12 rounded-xl bg-white shadow-lg border border-slate-100 flex items-center justify-center text-doramed-primary font-black text-lg">
                            {item.logo}
                        </div>
                    </div>
                    <div class="text-right px-1 mb-3">
                        <div class="flex items-center gap-1.5 justify-end mb-1">
                            <h3 class="text-sm font-black text-doramed-primary truncate">{item.name}</h3>
                            <Icon name={item.icon} class="w-4 h-4 text-doramed-primary shrink-0" />
                        </div>
                        <p class="text-slate-500 text-[11px] leading-relaxed">{item.desc}</p>
                    </div>
                    <div class="flex items-center justify-end gap-1.5 px-3 py-2 rounded-xl bg-emerald-50 text-emerald-600 text-xs font-black">
                        استقرار موفق
                        <Icon name="lucide:circle-check-big" class="w-4 h-4" />
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>
