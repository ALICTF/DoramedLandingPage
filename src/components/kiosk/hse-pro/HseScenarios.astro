---
// src/components/kiosk/hse-pro/HseScenarios.astro
// تم روشن - سناریوهای کاربردی (۵ کارت)
import { Icon } from "astro-icon/components";

const scenarios = [
    { title: "پایش کارکنان پرریسک", desc: "نظارت ویژه بر کارکنان با ریسک سلامتی بالا و مشاغل حساس.", icon: "lucide:triangle-alert" },
    { title: "کمپین سلامت سازمانی", desc: "اجرای برنامه‌های سلامت و ارتقاء سبک زندگی کارکنان.", icon: "lucide:heart-pulse" },
    { title: "پایش قبل از شیفت", desc: "غربالگری سریع قبل از ورود به محیط کار.", icon: "lucide:shield-check" },
    { title: "معاینات دوره‌ای", desc: "برنامه‌ریزی و اجرای دوره‌ای معاینات شغلی به‌صورت منظم.", icon: "lucide:calendar-check" },
    { title: "معاینات بدو استخدام", desc: "ارزیابی سلامت و تناسب شغلی نیروهای جدید.", icon: "lucide:user-check" },
];
---

<section class="py-16 lg:py-24 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6">

        <h2 class="text-2xl md:text-4xl font-black text-slate-800 text-center mb-12 md:mb-16">
            سناریوهای <span class="text-doramed-primary">کاربردی</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            {scenarios.map(s => (
                <div class="group bg-white rounded-2xl border border-slate-100 p-6 text-center shadow-[0_8px_25px_rgba(15,27,42,0.04)] hover:shadow-[0_12px_30px_rgba(2,62,138,0.12)] hover:border-doramed-primary/30 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-doramed-primary/8 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white transition-colors duration-300">
                        <Icon name={s.icon} class="w-7 h-7" />
                    </div>
                    <h3 class="text-sm md:text-base font-black text-slate-800 mb-2 group-hover:text-doramed-primary transition-colors">{s.title}</h3>
                    <p class="text-slate-500 text-xs leading-relaxed">{s.desc}</p>
                </div>
            ))}
        </div>

    </div>
</section>
