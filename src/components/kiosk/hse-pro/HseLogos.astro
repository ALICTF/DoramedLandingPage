---
// src/components/kiosk/hse-pro/HseLogos.astro
// نوار اعتماد - سازمان‌ها و صنایع همکار
const logos = [
    "کارخانه سیم کابل افلاک",
    "شرکت گاز",
    "شهرداری مشهد",
    "پتروشیمی",
    "صنایع فولاد",
    "هلدینگ انرژی",
];
---

<section class="py-10 lg:py-12 bg-white border-y border-slate-100">
    <div class="container mx-auto px-4 sm:px-6">
        <p class="text-center text-slate-400 text-xs md:text-sm font-bold mb-6">
            مورد اعتماد صنایع و سازمان‌های پیشرو
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4 md:gap-x-12">
            {logos.map(logo => (
                <span class="text-slate-400 hover:text-doramed-primary text-base md:text-lg font-black transition-colors grayscale hover:grayscale-0">
                    {logo}
                </span>
            ))}
        </div>
    </div>
</section>
