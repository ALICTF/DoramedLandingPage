---
// src/components/kiosk/hse-pro/HseTarget.astro
// تم روشن - مناسب برای (۷ کارت)
import { Icon } from "astro-icon/components";

const targets = [
    { title: "واحدهای HSE و طب کار", icon: "lucide:briefcase-medical" },
    { title: "پتروشیمی", icon: "lucide:factory" },
    { title: "شرکت‌های گاز", icon: "lucide:flame" },
    { title: "شهرداری‌ها", icon: "lucide:building-2" },
    { title: "آتش‌نشانی", icon: "lucide:siren" },
    { title: "پروژه‌های عمرانی", icon: "lucide:construction" },
    { title: "کارخانه‌ها", icon: "lucide:factory" },
];
---

<section class="py-16 lg:py-24 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6">

        <h2 class="text-2xl md:text-4xl font-black text-slate-800 text-center mb-12 md:mb-16">
            مناسب <span class="text-doramed-primary">برای</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-4">
            {targets.map(t => (
                <div class="group bg-white rounded-2xl border border-slate-100 p-5 flex flex-col items-center text-center gap-3 shadow-[0_8px_25px_rgba(15,27,42,0.04)] hover:shadow-[0_12px_30px_rgba(2,62,138,0.12)] hover:border-doramed-primary/30 hover:-translate-y-1 transition-all duration-300">
                    <div class="w-14 h-14 rounded-full bg-doramed-primary/8 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white transition-colors duration-300">
                        <Icon name={t.icon} class="w-7 h-7" />
                    </div>
                    <span class="text-slate-700 text-xs md:text-sm font-black leading-tight">{t.title}</span>
                </div>
            ))}
        </div>

    </div>
</section>
