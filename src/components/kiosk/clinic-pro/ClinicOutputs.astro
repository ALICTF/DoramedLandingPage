---
// src/components/kiosk/clinic-pro/ClinicOutputs.astro
// خروجی‌ها (۶ مورد در یک ردیف)
import { Icon } from "astro-icon/components";

const outputs = [
    { title: "تصمیم‌گیری داده‌محور", desc: "تحلیل روندها و شاخص‌ها برای تصمیم‌گیری بهتر.", icon: "lucide:chart-line" },
    { title: "گزارش برای پزشک", desc: "ارسال سریع و دقیق اطلاعات قبل از ویزیت.", icon: "lucide:file-text" },
    { title: "آرشیو اطلاعات سلامت", desc: "ذخیره امن و سازمان‌یافته داده‌ها.", icon: "lucide:database" },
    { title: "داشبورد مدیریتی", desc: "نمای کلان از عملکرد مرکز به صورت لحظه‌ای.", icon: "lucide:layout-dashboard" },
    { title: "گزارش فردی سلامت", desc: "گزارش کامل و قابل چاپ برای هر بیمار.", icon: "lucide:user-check" },
    { title: "خروجی PDF", desc: "تولید آنی فایل گزارش قابل اشتراک‌گذاری.", icon: "lucide:file-down" },
];
---

<section class="py-16 lg:py-24 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6">

        <h2 class="text-2xl md:text-4xl font-black text-slate-800 text-center mb-12 md:mb-16">
            <span class="text-doramed-primary">خروجی‌ها</span>
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-y-10 gap-x-4">
            {outputs.map(o => (
                <div class="group text-center px-2">
                    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-doramed-primary/8 flex items-center justify-center text-doramed-primary group-hover:bg-doramed-primary group-hover:text-white group-hover:-translate-y-1 transition-all duration-300">
                        <Icon name={o.icon} class="w-8 h-8" />
                    </div>
                    <h3 class="text-sm md:text-base font-black text-slate-800 mb-2 group-hover:text-doramed-primary transition-colors">{o.title}</h3>
                    <p class="text-slate-500 text-xs leading-relaxed">{o.desc}</p>
                </div>
            ))}
        </div>

    </div>
</section>
