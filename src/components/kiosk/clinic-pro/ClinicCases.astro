---
// src/components/kiosk/clinic-pro/ClinicCases.astro
// نمونه نصب و مشتریان (۳ کارت عکس + متن)
import { Image } from "astro:assets";

import imgMedical from "../../../assets/kiosk/sections/clinic-medical.jpg";
import imgSpecialty from "../../../assets/kiosk/sections/clinic-specialty.jpg";
import imgHospital from "../../../assets/kiosk/sections/clinic-hospital.jpg";

// logo: لوگوی مرکز (در صورت موجود بودن). فعلاً جای‌نگه‌دار با حرف اول نام.
const cases = [
    {
        name: "مراکز درمانی و تخصصی",
        desc: "یکپارچه‌سازی با سیستم‌های مرکز درمانی و پرونده الکترونیک سلامت.",
        img: imgMedical,
        logo: "م",
    },
    {
        name: "کلینیک‌های تخصصی",
        desc: "بهبود تجربه بیمار و افزایش بهره‌وری در کلینیک‌های تخصصی.",
        img: imgSpecialty,
        logo: "ک",
    },
    {
        name: "بیمارستان رضوی مشهد",
        desc: "استفاده از Clinic Pro در فرآیند پذیرش هوشمند و پایش علائم حیاتی بیماران.",
        img: imgHospital,
        logo: "ر",
    },
];
---

<section class="py-16 lg:py-24 bg-slate-50">
    <div class="container mx-auto px-4 sm:px-6">

        <h2 class="text-2xl md:text-4xl font-black text-slate-800 text-center mb-12 md:mb-16">
            نمونه نصب و <span class="text-doramed-primary">مشتریان</span>
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
            {cases.map(item => (
                <div class="group bg-white rounded-3xl border border-slate-100 overflow-hidden shadow-[0_8px_25px_rgba(15,27,42,0.05)] hover:shadow-[0_15px_40px_rgba(2,62,138,0.12)] hover:-translate-y-1 transition-all duration-300">
                    <!-- عکس محل نصب + لوگوی مرکز -->
                    <div class="relative w-full h-40">
                        <Image src={item.img} alt={item.name} width={500} height={300} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/35 to-transparent pointer-events-none"></div>
                        <!-- لوگوی مرکز (جای‌نگه‌دار) -->
                        <div class="absolute bottom-3 right-3 w-14 h-14 rounded-2xl bg-white shadow-lg border border-slate-100 flex items-center justify-center text-doramed-primary font-black text-xl">
                            {item.logo}
                        </div>
                    </div>
                    <div class="text-right p-5">
                        <h3 class="text-base font-black text-doramed-primary mb-1.5">{item.name}</h3>
                        <p class="text-slate-500 text-xs leading-relaxed">{item.desc}</p>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>
