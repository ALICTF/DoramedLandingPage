---
// src/components/kiosk/shared/KioskDashboards.astro
// دو داشبورد: داشبورد سلامت کاربر + داشبورد مدیریت کیوسک
import { Icon } from "astro-icon/components";

interface Props {
    bg?: "white" | "slate";
}

const { bg = "slate" } = Astro.props;
const sectionBg = bg === "white" ? "bg-white" : "bg-slate-50";

const userFeatures = [
    { icon: "lucide:clipboard-list", title: "مشاهده همه تست‌ها", desc: "تمام تست‌هایی که با کیوسک پایش سلامت انجام داده‌اید، به‌صورت یکجا قابل مشاهده و دانلود است." },
    { icon: "lucide:file-text", title: "گزارش تجمیعی", desc: "گزارش جامع و تجمیعی از روند سلامت خود را ببینید و به‌صورت فایل دانلود کنید." },
    { icon: "lucide:list-checks", title: "پاسخ به پرسشنامه‌ها", desc: "به پرسشنامه‌هایی که از سمت مدیریت برای پایش سلامت ارسال می‌شود، پاسخ دهید." },
    { icon: "lucide:upload-cloud", title: "بارگذاری فایل پزشکی", desc: "علاوه بر فایل‌های کیوسک، می‌توانید سایر فایل‌های پزشکی خود را روی سیستم بارگذاری کنید." },
];

const adminFeatures = [
    { icon: "lucide:stethoscope", title: "مشاهده تخصصی تست‌ها", desc: "مدیریت کیوسک می‌تواند به‌صورت کاملاً تخصصی تست‌های هر کاربر را بررسی کند." },
    { icon: "lucide:users", title: "پایش همه اعضا", desc: "تمام کارمندان، ورزشکاران یا بیمارانی که با کیوسک تست داده‌اند، قابل پایش هستند." },
    { icon: "lucide:bar-chart-3", title: "اطلاعات آماری کاربردی", desc: "گزارش‌ها و آمار دقیق از کیوسک و کاربران، برای تصمیم‌گیری بهتر مدیریت." },
    { icon: "lucide:shield-check", title: "دسترسی مدیریتی امن", desc: "لینک ورود، نام کاربری و رمز عبور برای ادمین کیوسک ارسال می‌شود." },
];
---

<section class={`py-16 lg:py-24 ${sectionBg} relative overflow-hidden`}>
    <div class="absolute top-0 right-0 w-[450px] h-[450px] bg-doramed-primary/5 blur-[130px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-sky-200/20 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto px-4 sm:px-6 relative z-10">

        <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-doramed-primary/8 text-doramed-primary text-sm font-bold mb-5">
                <Icon name="lucide:layout-dashboard" class="w-4 h-4" />
                داشبوردهای هوشمند
            </span>
            <h2 class="text-2xl md:text-4xl font-black text-slate-800 mb-4">
                داشبورد <span class="text-doramed-primary">کاربر</span> و <span class="text-doramed-primary">مدیریت</span>
            </h2>
            <p class="text-slate-500 text-base md:text-lg leading-relaxed">
                هم کاربران و هم مدیران کیوسک، به ابزارهای اختصاصی برای مشاهده، پایش و مدیریت داده‌های سلامت دسترسی دارند.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">

            <!-- داشبورد سلامت کاربر -->
            <div class="bg-white rounded-[2rem] border border-slate-100 shadow-[0_8px_30px_rgba(15,27,42,0.06)] p-7 lg:p-9 flex flex-col">
                <div class="flex items-center gap-4 mb-6">
                    <span class="w-14 h-14 shrink-0 rounded-2xl bg-doramed-primary/8 flex items-center justify-center text-doramed-primary">
                        <Icon name="lucide:user-round" class="w-7 h-7" />
                    </span>
                    <div class="text-right">
                        <h3 class="text-xl font-black text-slate-800">داشبورد سلامت کاربر</h3>
                        <p class="text-slate-400 text-sm font-bold mt-0.5">پرونده سلامت دیجیتال شما</p>
                    </div>
                </div>

                <ul class="space-y-4 mb-7 flex-1">
                    {userFeatures.map(f => (
                        <li class="flex items-start gap-3 text-right">
                            <span class="w-9 h-9 shrink-0 rounded-xl bg-doramed-primary/8 flex items-center justify-center text-doramed-primary">
                                <Icon name={f.icon} class="w-5 h-5" />
                            </span>
                            <div>
                                <h4 class="font-black text-slate-800 text-sm mb-0.5">{f.title}</h4>
                                <p class="text-slate-500 text-xs leading-relaxed">{f.desc}</p>
                            </div>
                        </li>
                    ))}
                </ul>

                <p class="text-slate-400 text-xs leading-relaxed mb-5 bg-slate-50 rounded-xl p-3 text-right">
                    قابلیت‌های بسیار خوب دیگری نیز به‌زودی به داشبورد سلامت کاربر اضافه خواهد شد.
                </p>

                <a href="https://kiosk.doramed.ir/subusers/login" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-doramed-primary hover:bg-doramed-dark text-white font-black rounded-2xl transition-all shadow-[0_12px_30px_rgba(2,62,138,0.25)] hover:shadow-[0_16px_40px_rgba(2,62,138,0.4)] active:scale-95">
                    <Icon name="lucide:log-in" class="w-5 h-5" />
                    ورود به داشبورد کاربر
                </a>
            </div>

            <!-- داشبورد مدیریت کیوسک -->
            <div class="bg-gradient-to-br from-doramed-primary to-doramed-dark rounded-[2rem] border border-white/10 shadow-2xl p-7 lg:p-9 flex flex-col relative overflow-hidden">
                <div class="absolute -top-10 -left-10 w-44 h-44 bg-sky-400/20 blur-3xl rounded-full pointer-events-none"></div>

                <div class="relative z-10 flex items-center gap-4 mb-6">
                    <span class="w-14 h-14 shrink-0 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center text-sky-200">
                        <Icon name="lucide:shield" class="w-7 h-7" />
                    </span>
                    <div class="text-right">
                        <h3 class="text-xl font-black text-white">داشبورد مدیریت کیوسک</h3>
                        <p class="text-sky-200/70 text-sm font-bold mt-0.5">پایش تخصصی کاربران و آمار</p>
                    </div>
                </div>

                <ul class="relative z-10 space-y-4 mb-7 flex-1">
                    {adminFeatures.map(f => (
                        <li class="flex items-start gap-3 text-right">
                            <span class="w-9 h-9 shrink-0 rounded-xl bg-white/10 border border-white/15 flex items-center justify-center text-sky-200">
                                <Icon name={f.icon} class="w-5 h-5" />
                            </span>
                            <div>
                                <h4 class="font-black text-white text-sm mb-0.5">{f.title}</h4>
                                <p class="text-sky-100/70 text-xs leading-relaxed">{f.desc}</p>
                            </div>
                        </li>
                    ))}
                </ul>

                <div class="relative z-10 flex items-start gap-3 bg-white/10 border border-white/15 rounded-2xl p-4 text-right">
                    <Icon name="lucide:key-round" class="w-6 h-6 text-sky-200 shrink-0 mt-0.5" />
                    <p class="text-sky-100/90 text-sm leading-relaxed">
                        لینک ورود، نام کاربری و رمز عبور داشبورد مدیریت پس از فعال‌سازی کیوسک برای ادمین ارسال می‌شود.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>
