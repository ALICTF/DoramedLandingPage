---
// src/components/kiosk/shared/KioskCTA.astro
import { contact } from "../../../data/site";
interface Props {
  title: string;
  titleAccent: string;
  description: string;
  phoneDisplay: string;
  phoneHref: string;
}
const { title, titleAccent, description, phoneDisplay, phoneHref } = Astro.props;
---

<section class="py-24 lg:py-36 bg-doramed-darker relative overflow-hidden text-center">

    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-doramed-primary/20 blur-[160px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 right-10 w-[300px] h-[300px] bg-cyan-500/10 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">

        <div class="max-w-4xl mx-auto bg-doramed-dark/40 backdrop-blur-xl border border-doramed-muted/30 rounded-[3rem] p-10 md:p-16 lg:p-20 shadow-2xl relative overflow-hidden group">

            <div class="absolute inset-0 bg-gradient-to-t from-doramed-primary/10 via-transparent to-transparent opacity-50 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>

            <div class="relative z-10">

                <h2 class="text-3xl md:text-5xl font-black text-white mb-6 leading-tight tracking-tight">
                    {title} <span class="text-transparent bg-clip-text bg-gradient-to-l from-cyan-400 to-blue-400">{titleAccent}</span>
                </h2>

                <p class="text-doramed-gray text-base md:text-lg mb-12 max-w-2xl mx-auto leading-relaxed">
                    {description}
                </p>

                <div class="flex flex-col items-center justify-center gap-4">
                    <a
                        href={phoneHref}
                        class="group/btn inline-flex items-center gap-4 px-8 py-5 bg-doramed-primary hover:bg-doramed-primary/80 text-white font-black text-xl md:text-2xl rounded-2xl shadow-[0_0_30px_rgba(2,62,138,0.5)] hover:shadow-[0_0_50px_rgba(6,182,212,0.4)] hover:-translate-y-1 active:scale-95 transition-all duration-300"
                    >
                        <svg class="w-7 h-7 text-cyan-300 group-hover/btn:animate-[bounce_1s_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        <span class="tracking-wider" dir="ltr">{phoneDisplay}</span>
                    </a>
                    <span class="text-xs font-bold text-doramed-gray/60 tracking-widest mt-2 uppercase">واحد مشاوره و فروش دورامد</span>
                </div>

                <div class="w-24 h-[1px] bg-gradient-to-r from-transparent via-doramed-muted/50 to-transparent mx-auto my-10"></div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-6 md:gap-12 text-doramed-gray text-sm md:text-base font-bold">
                    <a href={contact.website} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-cyan-400 transition-colors">
                        <span class="text-cyan-400/80">🌐</span>
                        www.doramed.ir
                    </a>
                    <a href="https://www.instagram.com/doramed_ir" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-cyan-400 transition-colors">
                        <span class="text-cyan-400/80">📱</span>
                        @doramed_ir
                    </a>
                </div>

            </div>

            <div class="absolute -bottom-10 -right-10 w-40 h-40 border border-white/5 rounded-full pointer-events-none group-hover:scale-110 transition-transform duration-700"></div>
            <div class="absolute -top-10 -left-10 w-40 h-40 border border-white/5 rounded-full pointer-events-none group-hover:scale-110 transition-transform duration-700"></div>
        </div>

    </div>
</section>
