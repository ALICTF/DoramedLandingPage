---
// src/components/kiosk/fitness-ai/FitnessReveal.astro
// انیمیشن fade-in هنگام اسکرول برای سکشن‌های صفحه (سبک و بدون وابستگی)
---

<style is:global>
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 0.6s ease, transform 0.6s ease;
        will-change: opacity, transform;
    }
    .reveal-on-scroll.is-visible {
        opacity: 1;
        transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
        .reveal-on-scroll {
            opacity: 1 !important;
            transform: none !important;
            transition: none;
        }
    }
</style>

<script>
    (function () {
        const reveal = (el) => el.classList.add("is-visible");

        const init = () => {
            const els = Array.prototype.slice.call(
                document.querySelectorAll(".reveal-on-scroll")
            );
            if (!els.length) return;

            // اگر IntersectionObserver نبود، همه را نمایش بده
            if (!("IntersectionObserver" in window)) {
                els.forEach(reveal);
                return;
            }

            // هر المانی که همین الان داخل ویوپورت است را فوراً نمایش بده
            const inView = (el) => {
                const r = el.getBoundingClientRect();
                const vh = window.innerHeight || document.documentElement.clientHeight;
                return r.top < vh * 0.92 && r.bottom > 0;
            };

            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            reveal(entry.target);
                            io.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.08, rootMargin: "0px 0px -8% 0px" }
            );

            els.forEach((el) => {
                if (inView(el)) {
                    reveal(el);
                } else {
                    io.observe(el);
                }
            });

            // در صورت تغییر اندازه پنجره، المان‌های دیده‌شده را نمایش بده
            const onResize = () => {
                document
                    .querySelectorAll(".reveal-on-scroll:not(.is-visible)")
                    .forEach((el) => {
                        if (inView(el)) reveal(el);
                    });
            };
            window.addEventListener("resize", onResize, { passive: true });

            // ایمنی: بعد از ۲.۵ ثانیه هر چیزی که هنوز مخفی مانده را نمایش بده
            setTimeout(() => {
                document
                    .querySelectorAll(".reveal-on-scroll:not(.is-visible)")
                    .forEach((el) => {
                        if (inView(el)) reveal(el);
                    });
            }, 2500);
        };

        // در بار اول و بعد از هر ناوبری View Transitions اجرا شود
        document.addEventListener("astro:page-load", init);
    })();
</script>
