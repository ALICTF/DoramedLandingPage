---
// src/components/kiosk/fitness-ai/FitnessStickyCTA.astro
// نوار CTA چسبان - بعد از اسکرول ظاهر می‌شود
import { Icon } from "astro-icon/components";
---

<div id="fitness-sticky-cta" class="fixed bottom-0 inset-x-0 z-50 translate-y-full transition-transform duration-300 pointer-events-none">
    <div class="container mx-auto px-4 sm:px-6 pb-4">
        <div class="pointer-events-auto bg-white/95 backdrop-blur-lg border border-slate-200 rounded-2xl shadow-[0_-5px_30px_rgba(15,27,42,0.12)] p-3 flex items-center justify-between gap-3">
            <div class="hidden sm:block text-right pr-2">
                <div class="font-black text-slate-800 text-sm">باشگاه خود را هوشمند کنید</div>
                <div class="text-slate-400 text-xs font-bold">مشاوره و دموی رایگان</div>
            </div>
            <div class="flex items-center gap-2 flex-1 sm:flex-none">
                <a href="tel:09199152292" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 bg-doramed-primary hover:bg-doramed-dark text-white font-black rounded-xl transition-colors text-sm active:scale-95">
                    <Icon name="lucide:calendar-check" class="w-4 h-4" />
                    درخواست دمو
                </a>
                <a href="tel:09199152292" class="inline-flex items-center justify-center gap-2 px-5 py-3 bg-doramed-primary/10 text-doramed-primary font-black rounded-xl hover:bg-doramed-primary/20 transition-colors text-sm">
                    <Icon name="lucide:phone" class="w-4 h-4" />
                    <span dir="ltr" class="hidden xs:inline">09199152292</span>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function initFitnessStickyCta() {
        const bar = document.getElementById("fitness-sticky-cta");
        if (!bar) return;
        const onScroll = () => {
            // بعد از اسکرول بیش از ۶۰۰ پیکسل نمایش بده
            if (window.scrollY > 600) {
                bar.classList.remove("translate-y-full");
            } else {
                bar.classList.add("translate-y-full");
            }
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
    }
    document.addEventListener("astro:page-load", initFitnessStickyCta);
</script>
