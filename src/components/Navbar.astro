---
// src/components/Navbar.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import SocialIcon from './ui/SocialIcon.astro';
import { navLinks, navSocials, type IconName } from '../data/site';

const pathname = new URL(Astro.request.url).pathname;
const isActive = (href: string) => {
    if (href === '/') return pathname === '/';
    return pathname.startsWith(href);
};

// Per-channel hover colors (presentation only — kept next to the markup that uses it).
const socialStyles: Record<IconName, { color: string; shadow: string }> = {
    telegram: { color: 'hover:bg-[#229ED9]', shadow: 'hover:shadow-[#229ED9]/40' },
    instagram: { color: 'hover:bg-gradient-to-tr from-[#FFB238] via-[#E01E5A] to-[#8A3AB9]', shadow: 'hover:shadow-[#E01E5A]/40' },
    phone: { color: 'hover:bg-green-500', shadow: 'hover:shadow-green-500/40' },
    linkedin: { color: 'hover:bg-[#0A66C2]', shadow: 'hover:shadow-[#0A66C2]/40' },
    globe: { color: 'hover:bg-doramed-primary', shadow: 'hover:shadow-doramed-primary/40' },
};
---

<header class="fixed top-4 md:top-6 left-0 right-0 z-50 flex justify-center px-4" id="main-header">

    <div class="relative w-full max-w-[95%] md:w-auto md:max-w-none group transition-transform duration-300">

        <div class="absolute inset-0 rounded-full bg-gradient-to-r from-transparent via-doramed-primary/50 to-transparent bg-[length:200%_200%] animate-border-pulse pointer-events-none opacity-70"></div>

        <nav class="relative bg-white/80 backdrop-blur-xl rounded-full border border-white/50 shadow-2xl shadow-doramed-primary/10 px-4 py-2.5 flex justify-between items-center md:gap-8 md:min-w-[700px]">

            <a href="/" class="flex items-center gap-2 shrink-0 relative z-20" aria-label="خانه">
                <Image
                    src={logoImg}
                    alt="لوگوی دورامد"
                    height={40}
                    loading="eager"
                    class="h-8 md:h-10 w-auto object-contain"
                />
            </a>

            <ul class="hidden md:flex items-center gap-1 bg-gray-50/80 p-1.5 rounded-full border border-gray-200/50 shadow-inner">
                {navLinks.map(link => {
                    const active = isActive(link.href);
                    const hasDropdown = !!link.dropdown;
                    return (
                        <li class={hasDropdown ? "relative group/nav" : ""}>
                            <a
                                href={link.href}
                                class={`relative px-5 py-2 rounded-full text-sm font-bold transition-all duration-300 flex items-center gap-2 overflow-hidden ${
                                    active
                                    ? 'bg-doramed-primary text-white shadow-lg shadow-doramed-primary/30 ring-2 ring-doramed-primary/20'
                                    : 'text-gray-500 hover:text-doramed-primary hover:bg-white hover:shadow-sm'
                                }`}
                            >
                                <span class="relative z-10">{link.text}</span>

                                {hasDropdown && (
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 relative z-10 transition-transform duration-300 group-hover/nav:rotate-180 text-gray-400 group-hover/nav:text-doramed-primary">
                                        <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                                    </svg>
                                )}

                                {hasDropdown && (
                                    <span class="relative flex h-2 w-2 z-10">
                                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-doramed-primary opacity-75"></span>
                                      <span class="relative inline-flex rounded-full h-2 w-2 bg-doramed-primary"></span>
                                    </span>
                                )}

                                {active && <div class="absolute inset-0 bg-gradient-to-tr from-white/20 to-transparent pointer-events-none"></div>}
                            </a>

                            {hasDropdown && (
                                <div class="absolute top-full right-0 pt-3 w-48 opacity-0 pointer-events-none translate-y-2 group-hover/nav:opacity-100 group-hover/nav:pointer-events-auto group-hover/nav:translate-y-0 transition-all duration-300 z-50">
                                    <ul class="w-full bg-white/95 backdrop-blur-xl rounded-2xl border border-gray-100 shadow-xl p-2 flex flex-col gap-1 text-right">
                                        {link.dropdown!.map(subLink => (
                                            <li>
                                                <a href={subLink.href} class="block px-4 py-2.5 rounded-xl text-sm font-bold text-gray-600 hover:text-doramed-primary hover:bg-gray-50 transition-colors" dir="ltr">
                                                    {subLink.text}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </li>
                    );
                })}
            </ul>

            <div class="hidden md:flex items-center gap-3 pl-1">
                {navSocials.map(social => (
                    <a
                        href={social.href}
                        target={social.external ? "_blank" : "_self"}
                        rel={social.external ? "noopener noreferrer" : undefined}
                        class={`group/icon relative w-10 h-10 rounded-full bg-white flex items-center justify-center text-gray-500 shadow-sm border border-gray-100 transition-all duration-300 hover:-translate-y-1 hover:text-white ${socialStyles[social.icon].color} ${socialStyles[social.icon].shadow}`}
                        aria-label={social.name}
                    >
                        <SocialIcon name={social.icon} />
                    </a>
                ))}
            </div>

            <button id="mobile-menu-btn" class="md:hidden relative z-20 w-10 h-10 rounded-full bg-gray-50 flex flex-col justify-center items-center gap-1.5 border border-gray-200 shadow-sm active:scale-95 transition-transform" aria-label="منو" aria-expanded="false" aria-controls="mobile-menu">
                <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-all duration-300 origin-center" id="line-1"></span>
                <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-all duration-300 origin-center" id="line-2"></span>
                <span class="w-5 h-0.5 bg-gray-600 rounded-full transition-all duration-300 origin-center" id="line-3"></span>
            </button>

            <div id="mobile-menu" class="absolute top-[calc(100%+12px)] left-0 right-0 bg-white/95 backdrop-blur-2xl rounded-3xl p-4 shadow-2xl shadow-doramed-primary/10 border border-gray-100 transform origin-top scale-y-0 opacity-0 transition-all duration-300 ease-out hidden">

                <ul class="flex flex-col gap-2 mb-4">
                    {navLinks.map(link => {
                        const active = isActive(link.href);
                        const hasDropdown = !!link.dropdown;
                        return (
                            <li>
                                {hasDropdown ? (
                                    <div class="flex flex-col w-full">
                                        <button
                                            data-mobile-dropdown-btn
                                            aria-expanded="false"
                                            class={`flex items-center justify-between p-3 rounded-2xl font-bold transition-all w-full text-right ${
                                                active ? 'bg-doramed-primary/10 text-doramed-primary' : 'text-gray-600 hover:bg-gray-50'
                                            }`}
                                        >
                                            <span class="flex items-center gap-2">
                                                {link.text}
                                                <span class="relative flex h-2 w-2">
                                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-doramed-primary opacity-75"></span>
                                                  <span class="relative inline-flex rounded-full h-2 w-2 bg-doramed-primary"></span>
                                                </span>
                                            </span>
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 transition-transform duration-300 mobile-chevron text-gray-400">
                                                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                                            </svg>
                                        </button>

                                        <ul data-mobile-dropdown-menu class="hidden flex-col gap-1 pr-6 pl-2 py-2 mt-1 bg-gray-50/50 rounded-2xl border border-gray-100/50 text-right">
                                            {link.dropdown!.map(subLink => (
                                                <li>
                                                    <a href={subLink.href} class="block p-2.5 rounded-xl text-sm font-bold text-gray-500 hover:text-doramed-primary transition-colors" dir="ltr">
                                                        {subLink.text}
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ) : (
                                    <a
                                        href={link.href}
                                        class={`flex items-center justify-between p-3 rounded-2xl font-bold transition-all ${
                                            active
                                            ? 'bg-doramed-primary/10 text-doramed-primary'
                                            : 'text-gray-600 hover:bg-gray-50'
                                        }`}
                                    >
                                        <span class="flex items-center gap-2">
                                            {link.text}
                                        </span>
                                        {active && <span class="w-2 h-2 rounded-full bg-doramed-primary"></span>}
                                    </a>
                                )}
                            </li>
                        );
                    })}
                </ul>

                <div class="border-t border-gray-100 pt-4 flex justify-around">
                     {navSocials.map(social => (
                        <a
                            href={social.href}
                            target={social.external ? "_blank" : "_self"}
                            rel={social.external ? "noopener noreferrer" : undefined}
                            class={`w-12 h-12 rounded-2xl flex items-center justify-center text-gray-500 shadow-sm border border-gray-100 ${socialStyles[social.icon].color} hover:text-white transition-colors`}
                            aria-label={social.name}
                        >
                            <SocialIcon name={social.icon} class="w-6 h-6" />
                        </a>
                     ))}
                </div>

            </div>

        </nav>
    </div>

</header>

<style>
    @keyframes border-pulse {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    .animate-border-pulse {
        animation: border-pulse 6s ease infinite;
    }

    .menu-open #line-1 { transform: rotate(45deg) translate(5px, 6px); }
    .menu-open #line-2 { opacity: 0; }
    .menu-open #line-3 { transform: rotate(-45deg) translate(5px, -6px); }
</style>

<script>
    function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        if (!btn || !menu) return;

        const toggleMenu = (forceClose = false) => {
            const isHidden = menu.classList.contains('hidden');
            if (forceClose || !isHidden) {
                menu.classList.add('scale-y-0', 'opacity-0');
                btn.classList.remove('menu-open');
                btn.setAttribute('aria-expanded', 'false');

                setTimeout(() => {
                    menu.classList.add('hidden');
                    // Collapse any open sub-menus when the main menu closes.
                    menu.querySelectorAll('[data-mobile-dropdown-menu]').forEach(m => {
                        m.classList.add('hidden');
                        m.classList.remove('flex');
                    });
                    menu.querySelectorAll('[data-mobile-dropdown-btn]').forEach(b => b.setAttribute('aria-expanded', 'false'));
                    menu.querySelectorAll('.mobile-chevron').forEach(c => c.classList.remove('rotate-180'));
                }, 300);
            } else {
                menu.classList.remove('hidden');
                btn.classList.add('menu-open');
                btn.setAttribute('aria-expanded', 'true');

                requestAnimationFrame(() => {
                    menu.classList.remove('scale-y-0', 'opacity-0');
                });
            }
        };

        btn.onclick = (e) => {
            e.stopPropagation();
            toggleMenu();
        };

        const closeOnClickOutside = (e: MouseEvent) => {
            const target = e.target as Node;
            if (!menu.classList.contains('hidden') && !menu.contains(target) && !btn.contains(target)) {
                toggleMenu(true);
            }
        };
        document.addEventListener('click', closeOnClickOutside);

        // Close the menu when a real link (not a dropdown toggle) is tapped.
        menu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => toggleMenu(true));
        });

        // Wire up every mobile dropdown toggle (not just the first one).
        menu.querySelectorAll<HTMLElement>('[data-mobile-dropdown-btn]').forEach(dropdownBtn => {
            const wrapper = dropdownBtn.parentElement;
            const submenu = wrapper?.querySelector('[data-mobile-dropdown-menu]');
            const chevron = dropdownBtn.querySelector('.mobile-chevron');
            if (!submenu || !chevron) return;

            dropdownBtn.onclick = (e: MouseEvent) => {
                e.stopPropagation();
                const isSubHidden = submenu.classList.contains('hidden');
                submenu.classList.toggle('hidden', !isSubHidden);
                submenu.classList.toggle('flex', isSubHidden);
                chevron.classList.toggle('rotate-180', isSubHidden);
                dropdownBtn.setAttribute('aria-expanded', String(isSubHidden));
            };
        });
    }

    document.addEventListener('astro:page-load', initMobileMenu);
</script>
